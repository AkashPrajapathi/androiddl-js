{
  "name": "androiddl",
  "version": "1.2.0",
  "description": "A lightweight PyTorch-inspired deep learning library for JavaScript",
  "type": "module",
  "main": "./dist/androiddl.umd.cjs",
  "module": "./dist/androiddl.js",
  "exports": {
    ".": {
      "import": "./dist/androiddl.js",
      "require": "./dist/androiddl.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "vite": "^8.3.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AkashPrajapathi/androiddl-js.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}